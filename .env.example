# Copy to .env and adjust for your local server.

# Secret used to sign session cookies. CHANGE THIS in production.
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database URL (local file). Swap for postgresql://... to scale later.
DATABASE_URL=sqlite:///./legal_analyst.db

# Local AI backend.
#   AI_BACKEND=mock    -> built-in heuristic analysis (no external service, default)
#   AI_BACKEND=ollama  -> call a local Ollama server (the "bigger local AI system")
AI_BACKEND=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
