# Copy to .env and adjust for your local server.

# Secret used to sign session cookies. CHANGE THIS in production.
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database URL (local file). Swap for postgresql://... to scale later.
DATABASE_URL=sqlite:///./legal_analyst.db

# Where uploaded / imported / analysis files are stored.
UPLOAD_DIR=./uploads
# Where the audit log is written.
LOG_DIR=./logs

# ---- LLM connectivity ----
# Default target: "local" (Ollama), "cloud" (OpenAI-compatible API), or "mock".
LLM_TARGET=mock

# Local, private inference via Ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Cloud API (OpenAI-compatible: OpenAI, Together, Groq, a local vLLM gateway...).
CLOUD_API_KEY=
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o-mini

# ---- SEC EDGAR ----
# SEC requires a contact string in the request User-Agent (your name + email).
EDGAR_IDENTITY=Your Name your.email@example.com
